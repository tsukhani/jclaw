{
  // Self-hosted Renovate config. Run by Jenkinsfile.renovate against Bitbucket
  // Server (origin). PRs land on Bitbucket; the existing /deploy flow propagates
  // merges to the github mirror. Schema reference:
  // https://docs.renovatebot.com/configuration-options/
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
  ],

  // No `schedule` directive — Jenkinsfile.renovate's cron (`H 6 * * 1`) is the
  // sole gate on when Renovate runs. A second Renovate-side schedule would
  // need its `timezone` kept in sync with the Jenkins server's clock, with no
  // error if they drift; cheaper to let the orchestrator decide. Each weekly
  // run opens PRs for whatever drift exists at that moment.

  // Disabled — Bitbucket Server doesn't have a native issues UI for the
  // Dependency Dashboard pattern Renovate's GitHub support uses. Renovate's own
  // bitbucket-server docs put it as "creating issues not implemented yet", and
  // the dashboard needs issues with dynamic Markdown checkboxes. Status
  // visibility comes from the open PR list instead.
  //
  // The github mirror DOES have Issues enabled, which looks like a way out and
  // is not: Renovate runs with RENOVATE_PLATFORM=bitbucket-server and builds the
  // dashboard on the platform it operates against, so it never reaches github at
  // all. Pointing it there instead would open dependency PRs on a mirror where
  // no development happens and nothing merges back — Bitbucket is the source of
  // truth and /deploy pushes onward to github, not the reverse. Note
  // Jenkinsfile.renovate's GITHUB_COM_TOKEN is for fetching changelogs, not
  // platform auth, and does not make github the platform.
  //
  // Setting this true is inert at best and has been reported to fail outright on
  // self-hosted Bitbucket (renovatebot/renovate#10517). Routing the dashboard to
  // Jira has been open upstream since 2022 (renovatebot/renovate#16625); if that
  // ever lands, this is the line to revisit.
  dependencyDashboard: false,

  // Wait 3 days after a package version is published before opening a PR for
  // it. Catches the 'shipped → breaking bug found → republished' cycle that
  // hits weekly with active OSS packages. (Renamed from `stabilityDays` in
  // Renovate v37; the old key still works but emits a deprecation warning.)
  minimumReleaseAge: "3 days",

  // Backpressure caps. prConcurrentLimit caps total open PRs Renovate has
  // authored; prHourlyLimit caps how fast new ones land in a single run.
  // Both are kept at 10 so a weekly run can drain a normal week's drift in
  // one trigger — prConcurrentLimit still prevents the PR list from
  // ballooning if merges fall behind.
  prConcurrentLimit: 10,
  prHourlyLimit: 10,

  // Match JClaw's '<scope>: <message>' commit convention so bot commits read
  // consistently with manual ones in git log.
  commitMessagePrefix: "deps:",
  commitMessageAction: "bump",

  // enabledManagers is an allowlist — managers not listed don't run, even
  // ones config:recommended would otherwise enable by default. 'gradle' +
  // 'gradle-wrapper' cover build.gradle.kts and gradle-wrapper.properties
  // (the entire Java dependency tree, plus Gradle itself); 'npm' covers
  // frontend/package.json including the pnpm pin in `packageManager`
  // (the gap that triggered switching from Dependabot); 'dockerfile' +
  // 'docker-compose' cover the prod + devcontainer images.
  enabledManagers: [
    "gradle",
    "gradle-wrapper",
    "npm",
    "dockerfile",
    "docker-compose",
    // custom.regex is the manager type for the customManagers block
    // below — needed in this list so Renovate's manager-enable gate
    // doesn't filter our regex manager out before it runs.
    "custom.regex",
  ],

  // Same family-grouping intent as the previous .github/dependabot.yml:
  // collapse the dozen-plus eslint plugins and similar lockstep-versioned
  // packages into one PR per family per cycle. update-types limits grouping to
  // minor+patch — major bumps land as individual PRs because they almost always
  // need code changes.
  packageRules: [
    {
      groupName: "vue",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["vue", "@vue/**", "vue-*"],
    },
    {
      groupName: "nuxt",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["nuxt", "@nuxt/**", "nuxi", "h3"],
    },
    // Block Nuxt 4.4.4 and 4.4.5 — both crash the dev server, in
    // different ways:
    //   - 4.4.4: SSR mode 500s with "Vite Node IPC socket path not
    //     configured." (verified 2026-05-04).
    //   - 4.4.5: SPA mode startup throws "No entry found in
    //     rollupOptions.input" from resolveServerEntry — the 4.4.4
    //     fix called resolveServer unconditionally on !ssr, but SPA
    //     builds have no server entry to resolve (verified
    //     2026-05-18, see project_nuxt_4_4_4_avoid memory).
    // Both regressions are invisible to CI because the harness doesn't
    // start the dev server, so the gate lives here. Drop the rule once
    // upstream ships a verified-fixed 4.4.6+.
    {
      matchPackageNames: ["nuxt"],
      allowedVersions: ">4.4.5",
    },
    // Block TypeScript 7.x. TS7 is the native (tsgo) compiler rewrite; it
    // dropped the `typescript/lib/tsc` package export that vue-tsc / Volar
    // shim into, so `pnpm typecheck` (nuxi typecheck -> vue-tsc) hard-fails
    // with ERR_PACKAGE_PATH_NOT_EXPORTED on every .vue file. vue-tsc's peer
    // range is a misleading `>=5.0.0` that claims a TS7 support it lacks, so
    // only the typecheck gate catches it — invisible to Renovate and pnpm,
    // which is why the lone `renovate/typescript-7.x` branch recurred weekly
    // and never merged. Tracking: vuejs/language-tools#5381 (waiting on a
    // Volar port, likely gated on TS 7.1). TS 6.x minors/patches still flow.
    // Lift to <8 (or drop) once a vue-tsc release > 3.3.7 supports the native
    // compiler, and bump typescript + vue-tsc + @vue/language-core together.
    {
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    // Block @tanstack/vue-table 9.x. v9 is an API rewrite: getCoreRowModel is
    // gone (the core row model is implicit), useVueTable became useTable, and
    // row models compose through tableFeatures() — so the v9 branch fails 32
    // tests across 6 files on a single `getCoreRowModel is not a function` at
    // DataTable.vue:57. Unlike the typescript hold above, this one is a code
    // change we could simply make; it's held because components/ui/table/** is
    // shadcn-vue-derived and shadcn has not migrated (shadcn-ui/ui#11389
    // recommends pinning to ^8.21.3), so porting now forks DataTable.vue from
    // upstream while future table pulls stay v8-shaped. Tracking: JCLAW-1063.
    // Lift once shadcn-vue ships a v9-based table registry, migrating
    // DataTable.vue in the same change.
    {
      matchPackageNames: ["@tanstack/vue-table"],
      allowedVersions: "<9",
    },
    // Block vitest 5. Every spec runs under `environment: 'nuxt'`, which resolves
    // through @nuxt/test-utils, and 4.2.0 declares `peer vitest: ^4.0.2`: its
    // exports map offers ./vitest-environment while vitest 5 resolves a
    // ./environments subpath that is not there ("is not exported under the
    // conditions [node, development, import]"). The failure mode is the reason
    // this is a hold and not a fix-forward: all 136 files fail to start a pool
    // worker and vitest reports "Test Files no tests", so a gate that only looks
    // for failures reads a suite that ran nothing as a clean run. Lift once
    // @nuxt/test-utils ships a peer range admitting vitest 5, bumping vitest,
    // @vitest/coverage-v8 and @nuxt/test-utils in the same change. 4.x minors and
    // patches still flow through the "vitest" group rule below.
    {
      matchPackageNames: ["vitest", "@vitest/**"],
      allowedVersions: "<5",
    },
    // The other half of that hold: nothing gates @nuxt/test-utils, so Renovate
    // already opens a PR the week its next major lands — and that major IS the
    // signal, because its version tracks vitest's exactly (3.x needs vitest
    // ^3.2.0, 4.x needs ^4.0.2). This rule does not change when the PR arrives,
    // only what it says: without the note the reviewer sees a routine test-utils
    // bump with no hint that it is the thing the vitest hold was waiting for.
    // Checked by hand instead, this is a registry poll nobody remembers to run —
    // the last such wait was 108 days (vitest 4.0.0 to test-utils 4.0.0).
    {
      matchPackageNames: ["@nuxt/test-utils"],
      matchUpdateTypes: ["major"],
      prBodyNotes: [
        "**This may unblock vitest 5.** `renovate.json5` holds vitest at `<5` because every spec runs under `environment: 'nuxt'`, and @nuxt/test-utils 4.x declares `peer vitest: ^4.0.2` — vitest 5 resolves a `./environments` subpath it does not export, so all test files fail to start a pool worker and the suite reports **\"Test Files no tests\"** rather than failing.",
        "If this release's `peerDependencies.vitest` admits 5.x: delete the `allowedVersions: \"<5\"` rule for `vitest`/`@vitest/**`, then bump **vitest, @vitest/coverage-v8 and @nuxt/test-utils in the same change**. Moving vitest alone reproduces the silent no-tests failure.",
        "Verify with `pnpm test` reporting a real test count — not merely a zero exit.",
      ],
    },
    {
      groupName: "eslint",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["eslint", "@eslint/**", "eslint-*"],
    },
    {
      groupName: "stylelint",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["stylelint", "stylelint-*", "postcss-*"],
    },
    {
      groupName: "tailwind",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["tailwindcss", "@tailwindcss/**"],
    },
    {
      groupName: "vitest",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["vitest", "@vitest/**", "@vue/test-utils", "happy-dom"],
    },

    // Disable Renovate's package-replacement preset for the regex
    // (customManager) manager. Replacements assume a Maven-style
    // groupId:artifactId coordinate when computing the replaceString,
    // which doesn't match Play 1.x's `groupId -> artifactId` arrow
    // form that our customManager extracts. Renovate logs "Cannot find
    // replaceString in current file content" every cycle if we don't
    // suppress this. Version updates (the actual value of the
    // customManager) still work — those use the regex's literal match
    // as the replaceString. If a Play 1.x dep ever genuinely needs a
    // groupId/artifactId rename, we do it manually.
    {
      matchManagers: ["custom.regex"],
      matchUpdateTypes: ["replacement"],
      enabled: false,
    },

    // Auto-merge patch and minor bumps directly to main via signed git push,
    // skipping Bitbucket's merge UI (which can't sign commits on Bitbucket
    // Server 7.21.10 — see JCLAW-180). Renovate runs as a catch-all here:
    // grouped bumps inherit automerge from this rule, ungrouped ones still
    // match by updateType. Major bumps fall through (matchUpdateTypes excludes
    // them) and continue to open PRs for human review, merged locally with a
    // signed git merge. Requires gitPrivateKey configured on the runner so the
    // resulting commits land verified on the github mirror.
    {
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
    },

    // Carve Java/Gradle minors back out of the catch-all above. Tika,
    // Playwright, and OkHttp minors have historically required exclude-graph
    // adjustments in build.gradle.kts (the long `exclude(group = ...)` lists
    // for tika-core / tika-parsers-standard-package / flexmark / telegrambots
    // exist precisely because each minor reshuffles the transitive set).
    // Patches still auto-merge — they almost never reshape transitives.
    // Must sit after the catch-all because Renovate evaluates packageRules
    // in order, last match wins.
    {
      matchManagers: ["gradle", "gradle-wrapper"],
      matchUpdateTypes: ["minor"],
      automerge: false,
    },

    // OpenTelemetry semconv: never automerge, and check the compile by hand.
    // semconv v1.42.0 deprecated every gen_ai.* convention and moved it to
    // open-telemetry/semantic-conventions-genai, which has published no release
    // and has no artifact on Maven Central — so there is nothing to migrate to.
    // Measured against 1.43.0-alpha: all 53 fields of GenAiIncubatingAttributes
    // carry @Deprecated, and GenAiSpans plus LatencyTrace use 17 of the
    // deprecated constants between them (verified 2026-09-09).
    // They are deprecated, not removed. A later release may delete them, and
    // that fails the build rather than warning. The catch-all above automerges
    // every patch, which would land that removal unreviewed, so this rule turns
    // automerge off for the whole group and a green compile is the gate. Drop it
    // once a GenAI artifact exists and those two classes move onto it.
    {
      matchPackageNames: ["io.opentelemetry.semconv:**"],
      automerge: false,
      prBodyNotes: [
        ":warning: `GenAiSpans` and `LatencyTrace` use 17 `gen_ai.*` constants that are deprecated upstream and may be **removed** in a release. Run `./gradlew compileJava` on this branch before merging — a removal breaks the build rather than warning.",
      ],
    },
  ],

  customManagers: [
    // Bump the Play fork pin in build.gradle.kts from tsukhani/play1's
    // GitHub releases. PF-90 retired the standalone .play-version file;
    // the framework version now lives inside build.gradle.kts as
    // `frameworkVersion.set("1.13.0")`, parsed at build time by the
    // production + devcontainer Dockerfiles. extractVersion strips the
    // leading 'v' so semver comparison happens on bare versions
    // (1.13.0), matching the file contents.
    {
      customType: "regex",
      // Renamed from `fileMatch` in Renovate v40; old key still works
      // but emits a deprecation warning each run.
      managerFilePatterns: ["^build\\.gradle\\.kts$"],
      matchStrings: [
        "frameworkVersion\\.set\\(\"(?<currentValue>[^\"]+)\"\\)",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "tsukhani/play1",
      extractVersionTemplate: "^v(?<version>.+)$",
      versioningTemplate: "semver",
    },
  ],
}
