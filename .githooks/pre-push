#!/usr/bin/env bash
# Pre-push hook: run the tests a push can break before it leaves the laptop.
# The backend runs only the test classes the pushed change reaches
# (bin/select-tests.mjs), the frontend checks only when a frontend input
# changed, and the bin/ scripts' node tests only when a bin/ file changed;
# Jenkins runs the whole Java suite on every push. A release commit over a
# green /release-check candidate runs only the fast checks and the bin/ tests.
# Skips the run when the current HEAD has already been tested (so the two-remote deploy flow, origin
# then github, pays once). Cache lives inside $GIT_DIR so it stays local to this
# clone and is automatically scoped per worktree.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass for a single push (use sparingly):  JCLAW_SKIP_TESTS=1 git push ...

set -euo pipefail

# git hands the hook one "<local ref> <local sha> <remote ref> <remote sha>" line per ref on stdin, read once here
# for the policy guard and the test scoping below.
refs=$(cat)
remote=${1:-}

# AGENTS.md's Policy block: only /deploy's and /renovate's pushes leave this clone (bin/README.md). It runs ahead of
# JCLAW_SKIP_TESTS, which skips the tests and never the guard; a missing node refuses the push.
if ! printf '%s\n' "$refs" | node "$(git rev-parse --show-toplevel)/bin/policy-guard.mjs" pre-push "$remote"; then
    exit 1
fi

if [[ "${JCLAW_SKIP_TESTS:-}" == "1" ]]; then
    echo "[jclaw pre-push] JCLAW_SKIP_TESTS=1 — skipping tests."
    exit 0
fi

# A deletion carries an all-zero local sha and pushes
# no commits, so a push made only of deletions has nothing to test — before
# this check, deleting a stale branch ran the whole suite against whatever
# unrelated HEAD the clone happened to be on. A tag on a commit the remote
# already has pushes no commits either: /deploy tags a release only after
# Jenkins built it, by which time HEAD may be a later, untested commit.
zero_sha=0000000000000000000000000000000000000000
on_remote() {
    [[ -n "$remote" && -n "$(git for-each-ref --contains "$1^{commit}" "refs/remotes/$remote" 2>/dev/null || true)" ]]
}
refs_seen=0; deletions_only=1; known_tags_only=1; candidates_only=1; pushed_sha=""; pushed_over=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "$local_ref" ]] && continue
    refs_seen=1
    [[ "$local_sha" == "$zero_sha" ]] && continue
    deletions_only=0
    if [[ "$remote_ref" == refs/heads/main ]]; then
        pushed_sha=$local_sha
        pushed_over=$remote_sha
    fi
    [[ "$local_ref" == refs/tags/* ]] && on_remote "$local_sha" || known_tags_only=0
    [[ "$remote_ref" == refs/heads/candidate/* ]] || candidates_only=0
done <<< "$refs"
if [[ "$refs_seen" == 1 && "$deletions_only" == 1 ]]; then
    echo "[jclaw pre-push] Push only deletes refs — nothing to test."
    exit 0
fi
if [[ "$refs_seen" == 1 && "$known_tags_only" == 1 ]]; then
    echo "[jclaw pre-push] Push only tags commits $remote already has — nothing to test."
    exit 0
fi
# A candidate reaches no main: /release-check pushes it so Jenkins can run the whole suite and Sonar on it (JF-441).
if [[ "$refs_seen" == 1 && "$candidates_only" == 1 ]]; then
    echo "[jclaw pre-push] Push only creates candidate/* branches, which their Jenkins build tests: nothing to test here."
    exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
git_dir=$(git rev-parse --git-dir)
cache_file="$git_dir/jclaw-last-tested-sha"
# The commit being pushed, not HEAD: /deploy names its release commit, and another session's commit landing between
# the two pushes must not make the second one test a tree it is not pushing.
current_sha=${pushed_sha:-$(git rev-parse HEAD)}

if [[ -f "$cache_file" ]] && [[ "$(cat "$cache_file")" == "$current_sha" ]]; then
    echo "[jclaw pre-push] $current_sha already tested — skipping."
    exit 0
fi

# This hook tests the checkout, so it can vouch only for HEAD. A commit it already tested passed above, which is what
# carries /deploy's second push past a commit another session landed after the first.
if [[ "$current_sha" != "$(git rev-parse HEAD)" ]]; then
    echo "[jclaw pre-push] HEAD has moved past $current_sha, and this hook can test only HEAD." >&2
    echo "[jclaw pre-push] It has not been tested, so nothing went out: run /deploy again for a release commit at HEAD." >&2
    exit 1
fi

# Path-aware skip: if the entire push range only touches documentation
# (docs/**, *.md at any depth, .github/**) or only bumps the version
# line in conf/application.conf, the test suite has nothing
# meaningful to validate. Doc-only and version-only-bump pushes drop
# to instant. Anything that touches real code paths (jclaw.sh, app/,
# conf/* beyond the version line, frontend/, test/, etc.) still runs
# the tests. Cache the SHA on skip so the second remote push in
# the two-remote /deploy flow also short-circuits.
should_skip_for_docs() {
    # No upstream → can't compute scope cheaply, fall through to tests
    git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1 || return 1

    local files
    files=$(git diff --name-only "@{u}..HEAD" 2>/dev/null) || return 1
    [[ -z "$files" ]] && return 1  # nothing changed (force-push?)

    # Files that aren't pure documentation. Filter out docs/**, any *.md,
    # and .github/** (CI configs). Anything left is a candidate for
    # "real code change."
    local non_docs
    non_docs=$(echo "$files" | grep -vE '^(docs/|.*\.md$|\.github/)' || true)
    [[ -z "$non_docs" ]] && return 0  # pure docs

    # Tolerate a version-only bump in conf/application.conf as the
    # single non-doc change. The diff in that file must contain only
    # +/-application.version=... lines (no other content edits).
    if [[ "$non_docs" == "conf/application.conf" ]]; then
        local non_version
        non_version=$(git diff "@{u}..HEAD" -- conf/application.conf \
            | grep -E '^[+-][^+-]' \
            | grep -vE '^[+-]application\.version=' || true)
        [[ -z "$non_version" ]] && return 0
    fi

    return 1  # has real code change, run tests
}

if should_skip_for_docs; then
    echo "[jclaw pre-push] Push range is docs-only or version-bump-only — skipping tests."
    echo "$current_sha" > "$cache_file"
    exit 0
fi

# The fast checks run before the slower suite, so a wildcard import, an import-order slip or a nullness error
# fails the push in seconds. With "frontend", they take in ESLint, Stylelint and the typecheck as well.
fast_checks() {
    echo "[jclaw pre-push] Running the fast checks..."
    if [[ "${1:-}" == frontend ]]; then
        (cd "$repo_root" && ./jclaw.sh check) && return 0
    else
        (cd "$repo_root" && ./jclaw.sh check --backend-only) && return 0
    fi
    echo "[jclaw pre-push] The fast checks failed: see the output above." >&2
    exit 1
}

# Nothing else runs the bin/ scripts' node tests, the policy guard's among them: not ./jclaw.sh test, not Jenkins.
# Their git runs in scratch repositories, so git's environment for this repository is cleared first (JF-299).
run_bin_tests() {
    echo "[jclaw pre-push] Running the bin/ script tests..."
    # shellcheck disable=SC2046  # one variable name per word is what unset needs
    if ! (cd "$repo_root" && unset $(git rev-parse --local-env-vars) && node --test bin/*.test.mjs); then
        echo "[jclaw pre-push] The bin/ script tests failed — push aborted." >&2
        exit 1
    fi
}

# The inputs the factory's frontend gate watches (.sandcastle/frontend-gate.ts FRONTEND_INPUTS).
frontend_inputs='^(frontend/|docs/user-guide/|bin/llms-full\.mjs$)'

# Whether $1 changes only the application.version line, as /deploy's release commit does. No grep -q in a pipe: under
# pipefail its early exit fails the pipeline, which would read here as "only the version changed".
version_only() {
    local diff extra
    [[ "$(git rev-list --parents -n 1 "$1" | wc -w | tr -d ' ')" == 2 ]] || return 1
    [[ "$(git diff --name-only "$1^" "$1")" == conf/application.conf ]] || return 1
    diff=$(git diff -U0 "$1^" "$1" -- conf/application.conf)
    grep -qE '^\+application[.]version=' <<< "$diff" || return 1
    extra=$(grep -E '^[-+]' <<< "$diff" | grep -vE '^(\+\+\+|---) ' | grep -vE '^[-+]application[.]version=' || true)
    [[ -z "$extra" ]]
}

# A release commit over a green /release-check candidate (JF-444): Jenkins ran the whole backend suite and the
# frontend tests on its parent's tree, so only what Jenkins never runs is run here, the fast checks and the bin/
# tests. A candidate the hook cannot confirm runs everything below.
if [[ -n "$pushed_sha" ]] && version_only "$current_sha"; then
    parent=$(git rev-parse "$current_sha^")
    if vouch=$(node "$repo_root/bin/candidate-vouch.mjs" "$parent" 2>&1); then
        echo "[jclaw pre-push] $current_sha changes only the version line of $parent, which candidate build $vouch passed whole: skipping the backend and frontend tests."
        frontend=frontend
        bin_changed=1
        if [[ -n "$pushed_over" && "$pushed_over" != "$zero_sha" ]] \
                && changed=$(git diff --name-only "$pushed_over...$current_sha" 2>/dev/null); then
            grep -qE "$frontend_inputs" <<< "$changed" || frontend=""
            grep -qE '^bin/' <<< "$changed" || bin_changed=0
        fi
        fast_checks "$frontend"
        [[ "$bin_changed" == 0 ]] || run_bin_tests
        echo "$current_sha" > "$cache_file"
        echo "[jclaw pre-push] Checks passed — proceeding with push."
        exit 0
    fi
    echo "[jclaw pre-push] No green candidate vouches for $parent ($vouch): running the tests."
fi

fast_checks

# The selection reads the compiled test classes, so they are compiled here as well.
echo "[jclaw pre-push] Compiling the tests..."
if ! compile_out=$(cd "$repo_root" && ./gradlew --quiet compileTestJava 2>&1); then
    printf '%s\n' "$compile_out" >&2
    echo "[jclaw pre-push] compileTestJava failed — see the output above." >&2
    exit 1
fi

# Without an upstream, node or a working selection, the whole suite runs as before.
backend_scope=all
run_frontend=1
run_bin=1
if base=$(git rev-parse --verify --quiet "@{u}") && command -v node >/dev/null 2>&1 \
        && selection=$(cd "$repo_root" && node bin/select-tests.mjs --base "$base" --head HEAD); then
    case "$selection" in
        ALL) backend_scope=all ;;
        NONE) backend_scope=none ;;
        *) backend_scope="$selection" ;;
    esac
    # A here-string, not a pipe: under pipefail, grep -q exiting at its first match fails the pipeline with git's
    # SIGPIPE.
    changed=$(git diff --name-only "$base...HEAD")
    if ! grep -qE "$frontend_inputs" <<< "$changed"; then
        run_frontend=0
    fi
    if ! grep -qE '^bin/' <<< "$changed"; then
        run_bin=0
    fi
fi
case "$backend_scope" in
    all) backend_label="the whole suite" ;;
    none) backend_label="nothing the change reaches" ;;
    *) backend_label="the classes the change reaches" ;;
esac
frontend_label=run
[[ "$run_frontend" == 1 ]] || frontend_label=skipped
bin_label=run
[[ "$run_bin" == 1 ]] || bin_label=skipped
echo "[jclaw pre-push] Backend: $backend_label; frontend checks: $frontend_label; bin/ tests: $bin_label. Jenkins runs the Java suite."

[[ "$run_bin" == 0 ]] || run_bin_tests

echo "[jclaw pre-push] Testing $current_sha before push..."
# Git exports GIT_DIR to a hook run in a worktree, and a test that runs git in a scratch directory inherits it:
# RestartProgressScriptTest's git add then lands in this repository's index while the test still passes (JF-299).
# The list is the one git's own scripts clear before they work in another repository.
# shellcheck disable=SC2046  # one variable name per word is what unset needs
if (cd "$repo_root" && unset $(git rev-parse --local-env-vars) \
        && JCLAW_TEST_BACKEND="$backend_scope" JCLAW_TEST_FRONTEND="$run_frontend" ./jclaw.sh test); then
    echo "$current_sha" > "$cache_file"
    echo "[jclaw pre-push] Tests passed — proceeding with push."
    exit 0
else
    echo "[jclaw pre-push] Tests FAILED — push aborted." >&2
    echo "[jclaw pre-push] To push anyway: JCLAW_SKIP_TESTS=1 git push ..." >&2
    exit 1
fi
