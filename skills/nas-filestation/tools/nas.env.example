# Synology FileStation connection config — copy to nas.env and fill in.
# NAS_PASS must be URL-encoded: '+' -> %2B, '|' -> %7C, '%' -> %25
NAS_URL="https://nas.example.com"
NAS_USER="api"
NAS_PASS="%24ecret%7Cpass"
# Leave empty if the NAS is not behind a Basic-auth reverse proxy
PROXY_USER=""
PROXY_PASS=""