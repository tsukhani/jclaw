# The secrets this skill needs. The operator adds each one in this skill's Secrets panel on the Skills page.
# No value goes in this file. One line per secret:  NAME=example-host   # what it is
# A description that starts with "Optional" marks a secret the skill can run without.
JIRA_PERSONAL_TOKEN=jira.example.com   # A Jira personal access token, sent as a Bearer token
